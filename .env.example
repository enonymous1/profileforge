# Copy to `.env` and fill in. Never commit `.env` — it may hold a token.

# --- GitHub identity (GH_USERNAME is required) ---
GH_USERNAME=your-github-username
GITHUB_TOKEN=

# --- Activity sync ---
TARGET_FILE=README.md
MAX_LINES=5
SPARKLINE_DAYS=30
EVENTS_PER_PAGE=50
GITHUB_API_BASE_URL=https://api.github.com
REQUEST_TIMEOUT=15
MAX_RETRIES=3
RATE_LIMIT_MAX_WAIT=300

# --- Markdown exporter ---
EXCLUDED_DIRS=.venv,venv,env,__pycache__,.git,.pytest_cache,.mypy_cache,.ruff_cache,build,dist,.idea,.vscode
ROLLUP_DIRS=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
